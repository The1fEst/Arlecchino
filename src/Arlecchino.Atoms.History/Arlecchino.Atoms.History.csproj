<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Arlecchino.Atoms.History</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Arlecchino.Atoms.History</PackageId>
    <Description>Undo and redo for Arlecchino atoms: atoms that record their changes, a bounded stack, and a file the history is written to.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../nuget/Arlecchino.Atoms.History.md" Pack="true" PackagePath="/README.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Arlecchino.Core/Arlecchino.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
