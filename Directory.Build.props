<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.12.0</Version>
    <Authors>fEst</Authors>
    <Product>Arlecchino</Product>
    <Description>A terminal UI framework for .NET: cell-grid renderer, view navigation, modals and a command palette, wired through Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>tui;terminal;console;ansi;ui;framework</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>What changed in this version: https://github.com/The1fEst/Arlecchino/blob/master/CHANGELOG.md#$(Version.Replace('.', ''))</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/The1fEst/Arlecchino</PackageProjectUrl>
    <RepositoryUrl>https://github.com/The1fEst/Arlecchino</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <EnablePackageValidation Condition="'$(IsPackable)' != 'false'">true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(IsPackable)' != 'false' and '$(Version)' != '2.0.0'">2.11.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/arlecchino-icon-128.png" Pack="true" PackagePath="/icon.png"
          Visible="false" />
  </ItemGroup>
</Project>
