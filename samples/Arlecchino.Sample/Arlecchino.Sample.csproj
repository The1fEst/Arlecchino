<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Arlecchino.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ArlecchinoViewNamespace>Arlecchino.Sample.Views</ArlecchinoViewNamespace>
    <PublishAot Condition="'$(AotProbe)' == 'true'">true</PublishAot>
    <InvariantGlobalization Condition="'$(AotProbe)' == 'true'">true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Arlecchino/Arlecchino.csproj" />
    <ProjectReference Include="../../src/Arlecchino.Generators/Arlecchino.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ArlecchinoViewNamespace" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateViews" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateStores" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateWidgets" />
    <CompilerVisibleProperty Include="ArlecchinoGenerateCommands" />
  </ItemGroup>
</Project>
